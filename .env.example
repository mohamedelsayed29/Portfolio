# Optional external availability API. Booking submissions always use /api/send-booking.
VITE_API_URL=

# Server-only booking delivery. Never rename this with a VITE_ prefix.
RESEND_API_KEY=your_resend_api_key_here
# Exact browser origins. Missing origins are rejected by the booking API.
BOOKING_ALLOWED_ORIGINS=https://hammerload.com,https://www.hammerload.com

# Trust only the actual Nginx peer (Docker's network gateway in production).
# See README-DEPLOY.md. Never trust all clients or arbitrary forwarded headers.
BOOKING_TRUSTED_PROXIES=

# Docker sets a persistent path automatically. For local API testing, use a
# private path outside public/ and dist/. One process must own each state file.
BOOKING_RATE_LIMIT_FILE=

# Required for booking submissions. Only the SITE key is public.
# Configure the widget for hammerload.com and www.hammerload.com.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
