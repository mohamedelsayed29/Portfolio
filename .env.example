# Optional external availability API. Booking submissions always use /api/bookings.
VITE_API_URL=

# Server-only booking delivery. Never rename these with a VITE_ prefix.
RESEND_API_KEY=
BOOKING_EMAIL=booking@hammerload.com
BOOKING_FROM_EMAIL=HammerLoad Website <booking@hammerload.com>

# Optional comma-separated origins when the API is hosted separately.
BOOKING_ALLOWED_ORIGINS=
